# Copie para .env e substitua os valores indicados antes de iniciar os containers.
POSTGRES_DB=pylogic
POSTGRES_USER=pylogic
POSTGRES_PASSWORD=replace-with-a-strong-local-password
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
API_PORT=8000

# Configure somente se a integração AWS SQS estiver habilitada.
AWS_REGION=us-east-1
SQS_QUEUE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Para execução local fora do Compose, use uma URL PostgreSQL real.
DATABASE_URL=postgresql+psycopg://pylogic:replace-with-a-strong-local-password@localhost:5432/pylogic
