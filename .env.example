# MOCK ONLY: copie para .env, substitua os placeholders e nunca use-os em produção.
POSTGRES_DB=pylogic
POSTGRES_USER=pylogic
POSTGRES_PASSWORD=MOCK_ONLY_replace-this-local-password
JWT_SECRET_KEY=MOCK_ONLY_replace-this-with-a-random-secret-at-least-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
API_PORT=8000

# Configure somente se a integração AWS SQS estiver habilitada.
AWS_REGION=us-east-1
SQS_QUEUE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Assistente compatível com Chat Completions. Deixe vazios para desabilitar.
AI_API_URL=
AI_API_KEY=
AI_MODEL=default
AI_TIMEOUT_SECONDS=20

# Para execução local fora do Compose, use uma URL PostgreSQL real.
DATABASE_URL=postgresql+psycopg://pylogic:MOCK_ONLY_replace-this-local-password@localhost:5432/pylogic
